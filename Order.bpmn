<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Web Modeler" exporterVersion="5452d68" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.6.0">
  <bpmn:process id="Process_0rjkdvp" name="Order process" isExecutable="true">
    <bpmn:extensionElements>
      <zeebe:versionTag value="final" />
    </bpmn:extensionElements>
    <bpmn:startEvent id="StartEvent_1" name="Order requested">
      <bpmn:extensionElements>
        <zeebe:properties>
          <zeebe:property name="camundaModeler:exampleOutputJson" value="{&#10;  &#34;orderTotal&#34;: 45.99,&#10;  &#34;customerId&#34;: &#34;cust30&#34;,&#10;  &#34;cardNumber&#34;: &#34;1234 5678&#34;,&#10;  &#34;cvc&#34;: &#34;123&#34;,&#10;  &#34;expiryDate&#34;: &#34;09/21x&#34;&#10;}" />
        </zeebe:properties>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_13tzbph</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_13tzbph" sourceRef="StartEvent_1" targetRef="Activity_0ia6i6d" />
    <bpmn:intermediateThrowEvent id="Event_1vkcyn1" name="Payment invoked">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:input source="=customerId" target="customerId" />
          <zeebe:input source="=orderId" target="orderId" />
          <zeebe:input source="=productPrice" target="orderTotal" />
          <zeebe:input source="=cardNumber" target="cardNumber" />
          <zeebe:input source="=cvc" target="cvc" />
          <zeebe:input source="=expiryDate" target="expiryDate" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1o8i4i5</bpmn:incoming>
      <bpmn:outgoing>Flow_174chha</bpmn:outgoing>
      <bpmn:signalEventDefinition id="SignalEventDefinition_1go650r" signalRef="Signal_3363fp2" />
    </bpmn:intermediateThrowEvent>
    <bpmn:sequenceFlow id="Flow_174chha" sourceRef="Event_1vkcyn1" targetRef="Event_0rsvvd3" />
    <bpmn:intermediateCatchEvent id="Event_0rsvvd3" name="Payment Received">
      <bpmn:incoming>Flow_174chha</bpmn:incoming>
      <bpmn:outgoing>Flow_15mnwr0</bpmn:outgoing>
      <bpmn:signalEventDefinition id="SignalEventDefinition_1jmg12g" signalRef="Signal_1p41qmu" />
    </bpmn:intermediateCatchEvent>
    <bpmn:sequenceFlow id="Flow_0c0y4ca" sourceRef="Activity_0ia6i6d" targetRef="Activity_0x6hcz3" />
    <bpmn:scriptTask id="Activity_0ia6i6d" name="Generate order id">
      <bpmn:extensionElements>
        <zeebe:script expression="=uuid()" resultVariable="orderId" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_13tzbph</bpmn:incoming>
      <bpmn:outgoing>Flow_0c0y4ca</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:endEvent id="Event_0vh2e6k">
      <bpmn:incoming>Flow_15mnwr0</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_15mnwr0" sourceRef="Event_0rsvvd3" targetRef="Event_0vh2e6k" />
    <bpmn:sequenceFlow id="Flow_0ji8akb" sourceRef="Activity_0x6hcz3" targetRef="Activity_06cjrxo" />
    <bpmn:serviceTask id="Activity_0x6hcz3" name="Get DummyJson Token" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="8" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="noAuth" target="authentication.type" />
          <zeebe:input source="POST" target="method" />
          <zeebe:input source="https://dummyjson.com/auth/login" target="url" />
          <zeebe:input source="={ &#34;Content-Type&#34;: &#34;application/json&#34; }" target="headers" />
          <zeebe:input source="20" target="connectionTimeoutInSeconds" />
          <zeebe:input source="20" target="readTimeoutInSeconds" />
          <zeebe:input source="{ &#34;username&#34;: &#34;emilys&#34;, &#34;password&#34;: &#34;emilyspass&#34;}" target="body" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="resultExpression" value="={&#10;  token: response.body.accessToken&#10;}" />
          <zeebe:header key="retryBackoff" value="PT0S" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0c0y4ca</bpmn:incoming>
      <bpmn:outgoing>Flow_0ji8akb</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_1o8i4i5" sourceRef="Activity_06cjrxo" targetRef="Event_1vkcyn1" />
    <bpmn:serviceTask id="Activity_06cjrxo" name="Get product info" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="8" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="bearer" target="authentication.type" />
          <zeebe:input source="=token" target="authentication.token" />
          <zeebe:input source="GET" target="method" />
          <zeebe:input source="=&#34;https://dummyjson.com/auth/products/&#34; + productId" target="url" />
          <zeebe:input source="20" target="connectionTimeoutInSeconds" />
          <zeebe:input source="20" target="readTimeoutInSeconds" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="resultExpression" value="={&#10;&#34;productName&#34;:response.body.title,&#10;&#34;productDescription&#34;:response.body.description,&#10;&#34;productPrice&#34;:response.body.price&#10;}" />
          <zeebe:header key="retryBackoff" value="PT0S" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0ji8akb</bpmn:incoming>
      <bpmn:outgoing>Flow_1o8i4i5</bpmn:outgoing>
    </bpmn:serviceTask>
  </bpmn:process>
  <bpmn:signal id="Signal_3363fp2" name="paymentInvoked" />
  <bpmn:signal id="Signal_1p41qmu" name="=&#34;paymentReceived_&#34; + orderId" />
  <bpmndi:BPMNDiagram id="BPMNDiagram_Process_0rjkdvp">
