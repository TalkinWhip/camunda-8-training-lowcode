  <bpmn:process id="Process_0rjkdvp" name="Order process" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1" name="Order requested">
      <bpmn:extensionElements>
        <zeebe:properties>
          <zeebe:property name="camundaModeler:exampleOutputJson" value="{&#10;  &#34;orderTotal&#34;: 45.99,&#10;  &#34;customerId&#34;: &#34;cust30&#34;,&#10;  &#34;cardNumber&#34;: &#34;1234 5678&#34;,&#10;  &#34;cvc&#34;: &#34;123&#34;,&#10;  &#34;expiryDate&#34;: &#34;09/21x&#34;&#10;}" />
