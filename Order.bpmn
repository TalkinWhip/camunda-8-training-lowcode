    <bpmn:sequenceFlow id="Flow_174chha" sourceRef="Event_1vkcyn1" targetRef="Event_0rsvvd3" />
    <bpmn:intermediateCatchEvent id="Event_0rsvvd3" name="Payment Received">
      <bpmn:incoming>Flow_174chha</bpmn:incoming>
