<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Web Modeler" exporterVersion="5452d68" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.6.0" camunda:diagramRelationId="acbe8290-ac45-42af-885d-dfe7e53bcd89">
  <bpmn:process id="PaymentProcess_20250225" name="Payment Process" isExecutable="true">
    <bpmn:scriptTask id="Activity_0yujbo9" name="Add 2% fee">
      <bpmn:extensionElements>
        <zeebe:script expression="=openAmount * 1.02" resultVariable="openAmount" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0hm4nsv</bpmn:incoming>
      <bpmn:outgoing>Flow_00d9u7w</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:subProcess id="Activity_17cgxb1" name="Charge credit card">
      <bpmn:incoming>Flow_00d9u7w</bpmn:incoming>
      <bpmn:outgoing>Flow_1ly1cuh</bpmn:outgoing>
      <bpmn:startEvent id="Event_07b4f04">
        <bpmn:outgoing>Flow_04wu9la</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:endEvent id="Event_0jxowgi">
        <bpmn:incoming>Flow_1lavcpt</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_04wu9la" sourceRef="Event_07b4f04" targetRef="Gateway_1eg120i" />
      <bpmn:sequenceFlow id="Flow_1lavcpt" sourceRef="Activity_1uaibx3" targetRef="Event_0jxowgi" />
      <bpmn:scriptTask id="Activity_1uaibx3" name="Write credit card output">
        <bpmn:extensionElements>
          <zeebe:script expression="=assert(string(openAmount)) + &#34; was charged from &#34; + assert(cardNumber) +  &#34;; cvc: &#34; + assert(cvc) + &#34;; Expiry date: &#34; + assert(expiryDate)" resultVariable="creditCardOutput" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_07kaxio</bpmn:incoming>
        <bpmn:outgoing>Flow_1lavcpt</bpmn:outgoing>
      </bpmn:scriptTask>
      <bpmn:exclusiveGateway id="Gateway_1eg120i" name="Is date length 5?">
        <bpmn:incoming>Flow_04wu9la</bpmn:incoming>
        <bpmn:outgoing>Flow_07kaxio</bpmn:outgoing>
        <bpmn:outgoing>Flow_0b37mv4</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sequenceFlow id="Flow_07kaxio" name="Yes" sourceRef="Gateway_1eg120i" targetRef="Activity_1uaibx3">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=string length(expiryDate) = 5</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_0b37mv4" name="No" sourceRef="Gateway_1eg120i" targetRef="Event_0zd3vfo">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=string length(expiryDate) != 5</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:endEvent id="Event_0zd3vfo" name="Invalid date">
        <bpmn:incoming>Flow_0b37mv4</bpmn:incoming>
        <bpmn:errorEventDefinition id="ErrorEventDefinition_1loqe7k" errorRef="Error_0np0ecl" />
      </bpmn:endEvent>
    </bpmn:subProcess>
    <bpmn:exclusiveGateway id="Gateway_0tguusb" name="Credit sufficient?" default="Flow_0hm4nsv">
      <bpmn:incoming>Flow_1fag6do</bpmn:incoming>
      <bpmn:outgoing>Flow_0mgtgv1</bpmn:outgoing>
      <bpmn:outgoing>Flow_0hm4nsv</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:scriptTask id="Activity_06we2x6" name="Deduct credit">
      <bpmn:extensionElements>
        <zeebe:script expression="=orderTotal - number(substring(customerId, -2))" resultVariable="openAmount" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0yir2wn</bpmn:incoming>
      <bpmn:outgoing>Flow_1fag6do</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:sequenceFlow id="Flow_00d9u7w" sourceRef="Activity_0yujbo9" targetRef="Activity_17cgxb1" />
    <bpmn:sequenceFlow id="Flow_0yir2wn" sourceRef="StartEvent_1" targetRef="Activity_06we2x6" />
    <bpmn:sequenceFlow id="Flow_1fag6do" sourceRef="Activity_06we2x6" targetRef="Gateway_0tguusb" />
    <bpmn:sequenceFlow id="Flow_1ly1cuh" sourceRef="Activity_17cgxb1" targetRef="Gateway_1sc74ys" />
    <bpmn:sequenceFlow id="Flow_1pztzhb" sourceRef="Gateway_1sc74ys" targetRef="Event_01h2mrh" />
    <bpmn:exclusiveGateway id="Gateway_1sc74ys">
      <bpmn:incoming>Flow_1ly1cuh</bpmn:incoming>
      <bpmn:incoming>Flow_0mgtgv1</bpmn:incoming>
      <bpmn:outgoing>Flow_1pztzhb</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_0hm4nsv" name="No" sourceRef="Gateway_0tguusb" targetRef="Activity_0yujbo9" />
    <bpmn:endEvent id="Event_01h2mrh" name="Payment completed">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:input source="=openAmount" target="openAmount" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1pztzhb</bpmn:incoming>
      <bpmn:signalEventDefinition id="SignalEventDefinition_0i43br3" signalRef="Signal_1sd2jk4" />
    </bpmn:endEvent>
    <bpmn:startEvent id="StartEvent_1" name="Payment requested">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="=orderId" target="orderId" />
          <zeebe:output source="=customerId" target="customerId" />
          <zeebe:output source="=cardNumber" target="cardNumber" />
          <zeebe:output source="=cvc" target="cvc" />
          <zeebe:output source="=expiryDate" target="expiryDate" />
          <zeebe:output source="=orderTotal" target="orderTotal" />
        </zeebe:ioMapping>
        <zeebe:properties>
          <zeebe:property name="camundaModeler:exampleOutputJson" value="{&#10;  &#34;orderTotal&#34;: 45.99,&#10;  &#34;customerId&#34;: &#34;cust30&#34;,&#10;  &#34;cardNumber&#34;: &#34;1234 5678&#34;,&#10;  &#34;cvc&#34;: &#34;123&#34;,&#10;  &#34;expiryDate&#34;: &#34;09/24&#34;&#10;}" />
        </zeebe:properties>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_0yir2wn</bpmn:outgoing>
      <bpmn:signalEventDefinition id="SignalEventDefinition_1awq247" signalRef="Signal_39j3r7c" />
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_0mgtgv1" name="Yes" sourceRef="Gateway_0tguusb" targetRef="Gateway_1sc74ys">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=openAmount &lt;= 0</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:endEvent id="Event_14rdpky" name="Payment completed">
      <bpmn:incoming>Flow_1rl0t0c</bpmn:incoming>
      <bpmn:signalEventDefinition id="SignalEventDefinition_1exc1zp" signalRef="Signal_1sd2jk4" />
    </bpmn:endEvent>
    <bpmn:boundaryEvent id="Event_0diwvmp" name="Invalid date" attachedToRef="Activity_17cgxb1">
      <bpmn:outgoing>Flow_1rl0t0c</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorEventDefinition_0aw80f9" errorRef="Error_0np0ecl" />
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_1rl0t0c" sourceRef="Event_0diwvmp" targetRef="Event_14rdpky" />
  </bpmn:process>
  <bpmn:signal id="Signal_3t4itd5" name="Signal_3t4itd5" />
  <bpmn:signal id="Signal_39j3r7c" name="paymentInvoked" />
